{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/broski-lib/drone-law/main/schema/dataset.schema.json",
  "title": "DroneLawDataset",
  "description": "A versioned collection of curated legal references, not flight authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "license", "jurisdictions", "regulations"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "kind": { "enum": ["published", "examples"] },
    "license": { "const": "https://creativecommons.org/publicdomain/zero/1.0/" },
    "jurisdictions": { "type": "array", "items": { "$ref": "#/definitions/jurisdiction" } },
    "regulations": { "type": "array", "items": { "$ref": "#/definitions/regulation" } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 120 },
    "text": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "date": { "type": "string", "format": "date" },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "additionalItems": false
    },
    "ring": { "type": "array", "minItems": 4, "items": { "$ref": "#/definitions/position" } },
    "polygon": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/ring" } },
    "geometry": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Polygon" },
            "coordinates": { "$ref": "#/definitions/polygon" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "MultiPolygon" },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/polygon" }
            }
          }
        }
      ]
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "level",
        "country",
        "parent_id",
        "is_example",
        "geometry",
        "geometry_source"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "level": { "enum": ["federal", "state", "tribal", "county", "municipal", "site"] },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "parent_id": { "anyOf": [{ "$ref": "#/definitions/id" }, { "type": "null" }] },
        "is_example": { "type": "boolean" },
        "geometry": { "$ref": "#/definitions/geometry" },
        "geometry_source": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "license", "accuracy"],
              "properties": {
                "url": { "$ref": "#/definitions/httpsUrl" },
                "license": { "$ref": "#/definitions/text" },
                "accuracy": { "$ref": "#/definitions/text" }
              }
            }
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "citation", "checked_on", "rights"],
      "properties": {
        "url": { "$ref": "#/definitions/httpsUrl" },
        "title": { "$ref": "#/definitions/text" },
        "citation": { "$ref": "#/definitions/text" },
        "checked_on": { "$ref": "#/definitions/date" },
        "rights": { "$ref": "#/definitions/text" }
      }
    },
    "regulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "jurisdiction_ids",
        "authority",
        "topics",
        "legal_status",
        "effective_from",
        "effective_until",
        "sources",
        "reviewed_on",
        "is_example",
        "supersedes"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "$ref": "#/definitions/text" },
        "jurisdiction_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/id" }
        },
        "authority": { "type": "string", "minLength": 1, "maxLength": 200 },
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "flight",
              "takeoff-landing",
              "property-use",
              "privacy",
              "registration",
              "pilot-qualification",
              "other"
            ]
          }
        },
        "legal_status": { "enum": ["effective", "future", "repealed", "unknown"] },
        "effective_from": { "anyOf": [{ "$ref": "#/definitions/date" }, { "type": "null" }] },
        "effective_until": { "anyOf": [{ "$ref": "#/definitions/date" }, { "type": "null" }] },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/source" } },
        "reviewed_on": { "$ref": "#/definitions/date" },
        "is_example": { "type": "boolean" },
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/id" }
        }
      }
    }
  }
}
